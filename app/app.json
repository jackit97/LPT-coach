{
  "expo": {
    "name": "LPT Coach",
    "slug": "lpt-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "lptcoach",
    "ios": {
      "bundleIdentifier": "com.lptcoach.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.lptcoach.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "d6ba70d8-9979-4ec6-8b5e-17fedf87fed2"
      }
    },
    "owner": "giacomocavallini1"
  }
}
