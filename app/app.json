{
  "expo": {
    "name": "LPT Coach",
    "slug": "lpt-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "lptcoach",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.lptcoach.app",
      "supportsTablet": "true"
    },
    "android": {
      "package": "com.lptcoach.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "LPT Coach",
      "short_name": "LPTCoach",
      "lang": "it",
      "backgroundColor": "#ffffff",
      "themeColor": "#ffffff",
      "startUrl": "/",
      "display": "standalone",
      "scope": "/",
      "meta": {
        "apple-mobile-web-app-capable": "yes",
        "apple-mobile-web-app-status-bar-style": "default",
        "apple-mobile-web-app-title": "LPT Coach"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "d6ba70d8-9979-4ec6-8b5e-17fedf87fed2"
      }
    },
    "owner": "giacomocavallini1"
  }
}